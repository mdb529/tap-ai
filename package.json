{
  "name": "tapiq",
  "version": "0.1.0",
  "private": true,
  "description": "TapIQ MVP -- a lightweight, portable feedback layer that lets business stakeholders contribute subject-matter context into an org's codebase.",
  "scripts": {
    "seeds:build": "python3 scripts/gen_employees.py && python3 scripts/gen_seeds.py",
    "db:build": "node scripts/build-db.mjs",
    "setup": "npm run seeds:build && npm run db:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "latest",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
